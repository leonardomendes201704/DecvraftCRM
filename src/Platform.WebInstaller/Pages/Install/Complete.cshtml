@page "/install/complete"
@model Platform.WebInstaller.Pages.Install.CompleteModel
@{
    ViewData["Title"] = "Conclusao";
}

<section class="installer-frame">
    <aside class="installer-sidebar">
        <div class="brand-mark">
            <span class="brand-name">Devcraft CRM</span>
            <span class="brand-context">Web Installer</span>
        </div>
        <partial name="_InstallerStepIndicator" model="Model" />
    </aside>

    <div class="installer-content">
        <header class="installer-header">
            <div>
                <h1>Instalacao concluida</h1>
                <p>O tenant inicial foi provisionado e o instalador foi bloqueado para novas execucoes.</p>
            </div>
            <span class="status-pill is-ready">Concluido</span>
        </header>

        <div class="installer-body">
            @if (Model.WizardState.Completion?.Succeeded == true)
            {
                <dl class="summary-list">
                    <div class="summary-row">
                        <dt>Tenant</dt>
                        <dd>@Model.WizardState.Completion.TenantId</dd>
                    </div>
                    <div class="summary-row">
                        <dt>Administrador</dt>
                        <dd>@Model.WizardState.Completion.AdminUserId</dd>
                    </div>
                    <div class="summary-row">
                        <dt>Modulos</dt>
                        <dd>@string.Join(", ", Model.WizardState.Completion.InstalledModules)</dd>
                    </div>
                </dl>
            }
            else
            {
                <div class="validation-panel">
                    <p>Nenhuma instalacao concluida foi encontrada nesta sessao.</p>
                </div>
            }

            <div class="action-row">
                <a class="button button-secondary" href="@InstallerWizardRoutes.Review">Voltar</a>
                <a class="button button-primary" href="@InstallerWizardRoutes.Welcome">Inicio</a>
            </div>
        </div>
    </div>
</section>
